generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                String       @id @default(uuid())
  name              String
  registrationNo    String?
  country           String       @default("FR")
  cashbackRate      Decimal      @default(0) @db.Decimal(5, 4)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?
  auditLogs         AuditLog[]
  inviteCodes       InviteCode[]
  invoices          Invoice[]
  members           User[]

  @@map("organizations")
}

model User {
  id                     String        @id @default(uuid())
  email                  String        @unique
  passwordHash           String
  firstName              String
  lastName               String
  phone                  String?
  locale                 String        @default("fr")
  role                   UserRole      @default(RESELLER)
  status                 UserStatus    @default(REGISTERED)
  accountType            AccountType   @default(INDIVIDUAL)
  cashbackRate           Decimal?      @db.Decimal(5, 4)
  organizationId         String?
  refreshTokenHash       String?
  emailVerifiedAt        DateTime?
  emailVerificationToken String?       @unique
  passwordResetToken     String?       @unique
  passwordResetExpiresAt DateTime?
  mfaEnabled             Boolean       @default(false)
  mfaSecret              String?
  gdprConsentAt          DateTime?
  marketingConsent       Boolean       @default(false)
  lastLoginAt            DateTime?
  lastLoginIp            String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  deletedAt              DateTime?
  registeredViaInvite    Boolean       @default(false)
  passportDocumentKey    String?
  businessLicenseKey     String?
  address                String?
  bankAccountName        String?
  bankName               String?
  bankIban               String?
  bankBic                String?
  auditLogs              AuditLog[]
  invoices               Invoice[]
  settlements            CashbackSettlement[]
  reservations           Reservation[]
  organization           Organization? @relation(fields: [organizationId], references: [id])

  @@map("users")
}

model InviteCode {
  id              String           @id @default(uuid())
  code            String           @unique
  status          InviteCodeStatus @default(ACTIVE)
  intendedRole    UserRole         @default(RESELLER)
  intendedOrgId   String?
  createdByUserId String
  usedByUserId    String?
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization?    @relation(fields: [intendedOrgId], references: [id])

  @@map("invite_codes")
}

model Invoice {
  id                String           @id @default(uuid())
  userId            String
  organizationId    String?
  s3Key             String?
  s3Bucket          String?
  originalFilename  String?
  mimeType          String?
  fileSizeBytes     Int?
  status            InvoiceStatus    @default(PENDING)
  invoiceNumber     String?
  purchaseDate      DateTime?
  vendorName        String?
  vendorAddress     String?
  brandName         String?
  storeLocation     String?
  itemDescription   String?
  itemCategory      String?
  currency          InvoiceCurrency?
  subtotalAmount    Decimal?         @db.Decimal(12, 2)
  taxAmount         Decimal?         @db.Decimal(12, 2)
  grandTotalAmount  Decimal?         @db.Decimal(12, 2)
  cashbackAmount    Decimal?         @db.Decimal(12, 2)
  ocrConfidence     Float?
  ocrRawJson        Json?
  fraudFlags        Json?
  reviewNote        String?
  uploadedAt        DateTime?
  ocrCompletedAt    DateTime?
  reviewedAt        DateTime?
  reviewedById      String?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  arithmeticCheck   String?
  lineItems         Json?
  needsReview       Boolean          @default(false)
  reviewReasons     String[]
  taxRefundAmount   Decimal?         @db.Decimal(12, 2)
  cashbackBreakdown Json?
  // 预约匹配:匹配成功后记录这张小票算在哪个预约头上(匹配失败被拒的小票为空)
  reservationId     String?
  // OCR 提取税号后解析出的商家,单独存一份便于排查匹配问题
  matchedMerchantId String?
  // 自动拒绝原因,买手端直接展示此字段
  rejectReason      String?
  // 模型自评的图片清晰度/可读性(0–1),规则 1"照片置信度"用它判定
  imageQuality      Float?
  // 客户确认返点金额:AWAITING_CONFIRMATION → CONFIRMED(金额锁定)/ DISPUTED
  confirmedAt       DateTime?
  disputedAt        DateTime?
  disputeCategory   String?
  disputeReason     String?
  disputeCount      Int              @default(0)
  // 后台处理异议后给客户看的复核说明
  disputeResolutionNote String?
  organization      Organization?    @relation(fields: [organizationId], references: [id])
  user              User             @relation(fields: [userId], references: [id])
  settlement        CashbackSettlement?
  reservation       Reservation?     @relation(fields: [reservationId], references: [id])
  matchedMerchant   Merchant?        @relation(fields: [matchedMerchantId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([purchaseDate])
  @@index([vendorName])
  @@index([reservationId])
  // 条形码去重:invoiceNumber = 条形码下方数字串。另有部分唯一索引
  // invoices_user_barcode_active_key (userId, invoiceNumber) WHERE status <> 'REJECTED'
  // 在迁移 SQL 里手写(Prisma 不支持 partial index)。
  @@index([invoiceNumber])
  @@map("invoices")
}

// ─────────────────────────────────────────────
// 商家表:预约和小票匹配的锚点
// ─────────────────────────────────────────────
model Merchant {
  id           String        @id @default(cuid())
  // 商家的法定税号(SIRET,14 位数字)。OCR 从小票提取税号后精准匹配
  taxId        String        @unique
  // 买手端下拉列表和预约列表里展示给用户看的名字
  name         String
  // 下架商家从预约下拉框消失,但不能删除记录——历史预约和小票还引用着它
  active       Boolean       @default(true)
  reservations Reservation[]
  invoices     Invoice[]
  createdAt    DateTime      @default(now())

  @@map("merchants")
}

// ─────────────────────────────────────────────
// 预约表:全局一张表,每行 = 用户×商家×时间段
// ─────────────────────────────────────────────
model Reservation {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  merchantId  String
  merchant    Merchant          @relation(fields: [merchantId], references: [id])
  // 预约时间窗口(存 UTC,业务按 Europe/Paris 解释,精度到天)。
  // 发票日期必须落在 [startAt, endAt] 闭区间。
  startAt     DateTime
  endAt       DateTime
  // 小票匹配只在 ACCEPTED 的预约里找
  status      ReservationStatus @default(PENDING)
  // 后台谁在什么时候通过/拒绝的(审计记录)
  reviewedAt  DateTime?
  reviewedBy  String?
  // 后台拒绝时填写的原因
  rejectNote  String?
  // 客户什么时候取消的
  cancelledAt DateTime?
  invoices    Invoice[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, status])
  @@index([merchantId, startAt, endAt])
  @@map("reservations")
}

model CashbackSettlement {
  id              String           @id @default(uuid())
  invoiceId       String           @unique
  userId          String
  amount          Decimal          @db.Decimal(12, 2)
  method          SettlementMethod
  status          SettlementStatus @default(CONFIRMED)
  bankAccountName String?
  bankIban        String?
  bankBic         String?
  partnerRef      String?
  failureReason   String?
  confirmedAt     DateTime         @default(now())
  sentAt          DateTime?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  user            User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("cashback_settlements")
}

model MerchantCashbackConfig {
  id            String              @id @default(uuid())
  merchantKey   String              @unique
  displayName   String
  matchKeywords String[]            @default([])
  defaultRate   Decimal             @default(0) @db.Decimal(5, 4)
  notes         String?
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  updatedAt     DateTime            @updatedAt
  createdAt     DateTime            @default(now())
  brandRules    BrandCashbackRule[]

  @@map("merchant_cashback_configs")
}

model BrandCashbackRule {
  id           String                 @id @default(uuid())
  merchantId   String
  displayLabel String
  brands       String[]               @default([])
  rate         Decimal                @default(0) @db.Decimal(5, 4)
  condition    String?
  sortOrder    Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  merchant     MerchantCashbackConfig @relation(fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("brand_cashback_rules")
}

model MerchantBill {
  id           String   @id @default(uuid())
  merchantName String
  date         DateTime @db.Date
  totalAmount  Decimal  @db.Decimal(12, 2)
  importedAt   DateTime @default(now())

  @@unique([merchantName, date])
  @@index([merchantName])
  @@index([date])
  @@map("merchant_bills")
}

model AuditLog {
  id             String        @id @default(uuid())
  actorId        String?
  actorRole      String?
  action         String
  resourceType   String
  resourceId     String?
  meta           Json?
  ipAddress      String?
  userId         String?
  organizationId String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserRole {
  ADMIN
  REVIEWER
  ORG_ADMIN
  RESELLER
}

enum AccountType {
  INDIVIDUAL
  ORGANIZATION
}

enum UserStatus {
  REGISTERED
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

enum InviteCodeStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum SettlementMethod {
  BANK_TRANSFER
  VOUCHER
  GIFT_CARD
}

enum SettlementStatus {
  CONFIRMED
  SENT
  PAID
  FAILED
}

enum InvoiceStatus {
  PENDING                // 人工审核中(自动审核通过后)
  APPROVED               // 旧状态,保留兼容;后台通过后直接进 AWAITING_CONFIRMATION
  REJECTED               // 自动或人工拒绝
  AWAITING_CONFIRMATION  // 待客户确认返点金额
  CONFIRMED              // 客户已确认,金额锁定,可选结算方式
  DISPUTED               // 客户对金额有异议,回到人工审核队列
}

enum ReservationStatus {
  PENDING   // 审核中(创建后默认)
  ACCEPTED  // 后台通过
  REJECTED  // 后台拒绝
  CANCELLED // 客户取消
}

enum InvoiceCurrency {
  EUR
  USD
  GBP
  CNY
  JPY
  CHF
}
