# Application
NODE_ENV=production
PORT=3001

# Database
DATABASE_URL="postgresql://lidp:CHANGE_ME@postgres:5432/lidp_db"

# Redis
REDIS_URL="redis://redis:6379"

# JWT — generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME"
JWT_EXPIRY="15m"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_REFRESH_EXPIRY="7d"

# Mistral OCR
MISTRAL_API_KEY="CHANGE_ME"

# Frontend URL (used for CORS)
FRONTEND_URL="http://localhost:3000"

# Partner payout company (automatic bank-transfer settlement)
PAYOUT_API_URL="CHANGE_ME"
PAYOUT_API_KEY="CHANGE_ME"
PAYOUT_WEBHOOK_SECRET="CHANGE_ME"

# OCR 自动审核:照片置信度阈值(0–1 或 0–100),低于阈值自动拒绝,默认 0.8
OCR_MIN_CONFIDENCE=0.8
